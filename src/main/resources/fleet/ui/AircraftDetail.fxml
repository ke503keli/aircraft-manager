<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fleet.ui.AircraftDetailController">

    <top>
        <Label fx:id="titleLabel" text="Aircraft" style="-fx-font-size: 18px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <TextArea fx:id="detailsArea" editable="false" wrapText="true">
            <BorderPane.margin>
                <Insets top="12" right="12" bottom="12" left="12"/>
            </BorderPane.margin>
        </TextArea>
    </center>


    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <padding><Insets top="8" right="12" bottom="12" left="12"/></padding>
            <Button text="Back to List" onAction="#onBack"/>
            <Button text="Log Flight" onAction="#onLogFlight"/>
            <Button text="Perform Maintenance" onAction="#onPerformMaintenance"/>
            <Button text="Delete Aircraft" onAction="#onDeleteAircraft" style="-fx-text-fill: #b00020;"/>
        </HBox>
    </bottom>


</BorderPane>