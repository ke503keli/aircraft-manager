<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fleet.ui.LogFlightController">
    <top>
        <VBox spacing="4">
            <BorderPane.margin>
                <Insets top="12" right="12" bottom="4" left="12"/>
            </BorderPane.margin>
            <Label text="Log Flight" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label fx:id="aircraftLabel" wrapText="true"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <BorderPane.margin>
                <Insets top="8" right="12" bottom="12" left="12"/>
            </BorderPane.margin>

            <Label text="Time to log (H:MM, e.g. 1:34)"/>
            <TextField fx:id="hoursField"/>

            <Label text="Cycles to add (takeoff/landing pairs)"/>
            <TextField fx:id="cyclesField"/>

            <Label fx:id="errorLabel" wrapText="true" style="-fx-text-fill: red;"/>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="8">
            <padding><Insets top="8" right="12" bottom="12" left="12"/></padding>
            <Button text="Cancel" onAction="#onCancel"/>
            <Button text="Log Flight" onAction="#onSave"/>
        </HBox>
    </bottom>
</BorderPane>